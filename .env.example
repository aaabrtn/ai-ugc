# Copy this file to .env and fill in your key. .env is gitignored — never commit real keys.

# Required for prompt generation (Phase 2): AI vision is used to write precise,
# product-accurate descriptions of the garment, the character, and the setting
# from their reference photos.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5.
# AI_UGC_VISION_MODEL=claude-sonnet-5

# Required for video generation (Phase 3): your KIE API key.
KIE_API_KEY=

# Optional — defaults to gemini-omni-video.
# KIE_MODEL=gemini-omni-video

# Required for video generation (Phase 3): KIE needs every reference image (setting,
# garment) at a public URL, so the app uploads them to Google Drive first. Point this
# at a service account JSON key file (share your Drive folder with that service
# account's email address so it can write to it). Also required for Phase 4 (saving
# finished videos to a dated Drive folder).
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional — a specific Drive folder ID to upload input reference images into.
# If unset, the app creates/reuses a folder named "AI UGC Inputs" at the Drive root.
GOOGLE_DRIVE_INPUT_FOLDER_ID=
