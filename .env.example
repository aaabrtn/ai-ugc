# Copy this file to .env and fill in your key. .env is gitignored — never commit real keys.

# Required for prompt generation (Phase 2): AI vision is used to write precise,
# product-accurate descriptions of the garment, the character, and the setting
# from their reference photos.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5.
# AI_UGC_VISION_MODEL=claude-sonnet-5

# Required for video generation (Phase 3): your KIE API key.
KIE_API_KEY=

# Optional — defaults to gemini-omni-video.
# KIE_MODEL=gemini-omni-video

# No separate key needed for image hosting: KIE requires every reference image
# (setting, garment, character) at a public URL, so the app uploads them to KIE's
# own File Upload API first (see app/integrations/kie.py) using this same
# KIE_API_KEY — no third-party host involved.

# Optional — shows a cost estimate per video (Generator page + History tab).
# The AI-vision cost (garment/persona/setting descriptions) is always shown —
# it's computed exactly from Anthropic's own token counts, no config needed.
# KIE's task-status API has no per-task price field, so its cost is instead
# this flat rate — accurate as long as every video is submitted with the same
# settings the app always uses (10s, 9:16, 720p, no video input), which it is.
# Per KIE's own pricing table for gemini-omni-flash-1-1, that combination is
# 126 credits ($0.63) — the values below. If KIE changes pricing or you're on
# a different model, check kie.ai's pricing page for the "10s / 720p / no
# video input" row and update these two numbers; setting KIE_CREDITS_PER_VIDEO
# also backfills the cost onto any past videos that don't have one yet.
KIE_CREDITS_PER_VIDEO=126
KIE_USD_PER_CREDIT=0.005
